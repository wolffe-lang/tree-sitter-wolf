{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "wolf",
      "camelcase": "Wolf",
      "scope": "source.wolf",
      "path": ".",
      "file-types": ["lu"],
      "injection-regex": "^wolf$",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0-or-later",
    "description": "Wolf grammar for tree-sitter (.lu, lupus)",
    "authors": [
      {
        "name": "wolffe-lang"
      }
    ],
    "links": {
      "repository": "https://github.com/wolffe-lang/tree-sitter-wolf"
    }
  }
}
